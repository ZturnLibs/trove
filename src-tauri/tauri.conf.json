{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove",
  "version": "1.3.1",
  "identifier": "com.trove.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4720",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node ../scripts/lipo-extra-bins.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      },
      {
        "label": "quick",
        "title": "快速记录",
        "width": 560,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "tray-today",
        "title": "今日",
        "width": 380,
        "height": 520,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "trove"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyMkNBOTQ3Mjg0MjM1OUEKUldTYU5VSW9SNmtzb3B0OGRIN2ZCYmFOUG9YZ3Z3VUo5Vlh5MEFQOGNKY1Q1M3l1NncrYkNEaE0K",
      "endpoints": [
        "https://github.com/ZturnLibs/trove/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
