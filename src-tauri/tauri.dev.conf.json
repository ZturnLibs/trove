{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trove Dev",
  "identifier": "com.trove.dev",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trove Dev",
        "width": 1080,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "visible": true
      },
      {
        "label": "quick",
        "title": "Trove Dev 快速记录",
        "width": 560,
        "height": 420,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "tray-today",
        "title": "Trove Dev 今日",
        "width": 380,
        "height": 520,
        "resizable": false,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "trove-dev"
        ]
      }
    }
  }
}
